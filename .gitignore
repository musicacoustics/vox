# MATLAB autosaves and temporary files
*.asv
*.m~
*.autosave

# Operating system files
Thumbs.db
.DS_Store
desktop.ini

# Local editor settings (may contain machine-specific paths)
.vscode/settings.json

# Machine-specific path file, no longer used (vox.m finds its own folder)
VOX/matlab/voxpath
VOX/matlab/voxpath.mat

# Everything VOX writes: results, session files, WAV, movies, CSV,
# parameter files (#29). The example results are in VOX/matlab/examples/.
VOX/matlab/out/

# Files that VOX wrote next to vox.m before #29; vox moves them into out/
# at its next start (voxmoveoutput.m)
VOX/matlab/out*.mat
VOX/matlab/out*.wav
VOX/matlab/out_vf_n00000
VOX/matlab/last_filename.mat
VOX/matlab/recorded.mat
VOX/matlab/background.mat
VOX/matlab/para*.mat
VOX/matlab/*.wav
VOX/matlab/*.avi
VOX/matlab/foldmov_*.fig
VOX/matlab/combimov_*.fig
VOX/matlab/externalforce_glottalarea_*.csv
